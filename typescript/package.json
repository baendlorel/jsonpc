{
  "name": "jsonpc-ts",
  "version": "0.4.0",
  "author": {
    "name": "Kasukabe Tsumugi",
    "email": "futami16237@gmail.com"
  },
  "purpose": "npm",
  "description": "This is a lightweight JSON variant that allows comments under certain conditions.",
  "description_zh": "这是一个轻量级的、可以写注释的json，注释满足一定条件",
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "int": "tsx tests/interpret.ts",
    "pub": "tsx ./pub.ts",
    "test": "vitest",
    "build": "tsdown --env.production",
    "try": "tsx src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baendlorel/jsonpc.git"
  },
  "keywords": [
    "json",
    "comments",
    "typescript",
    "nodenext"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/baendlorel/jsonpc/issues"
  },
  "homepage": "https://github.com/baendlorel/jsonpc/tree/main/#readme",
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@types/node": "^26.4.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}